# Modelo de configuracao. Java/Spring nao carrega este arquivo automaticamente.
# Copie os valores para as variaveis de ambiente do IntelliJ ou da hospedagem.
DB_URL=jdbc:mysql://localhost:3306/evoluamais?connectTimeout=10000&socketTimeout=30000
DB_USUARIO=seu_usuario
DB_SENHA=
OPENROUTER_API_KEY=
PORT=8080

# Web Push (gere as chaves VAPID; a chave privada nunca deve ir para o front-end)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email-real-da-equipe
